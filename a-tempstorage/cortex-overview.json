{
  "__requires": [
    {
      "type": "panel",
      "id": "graph",
      "name": "Graph",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "3.1.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "title": "Cortex Overview",
  "description": "High-level overview of Cortex cluster performance and health",
  "tags": ["cortex", "overview", "corbench"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "panels": [
      {
        "id": 1,
        "title": "Ingestion Rate",
        "type": "stat",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(rate(cortex_distributor_samples_in_total[5m]))",
            "legendFormat": "Samples/sec"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"}
          }
        }
      },
      {
        "id": 2,
        "title": "Query Rate",
        "type": "stat",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(rate(cortex_query_frontend_queries_total[5m]))",
            "legendFormat": "Queries/sec"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Active Series",
        "type": "stat",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(cortex_ingester_memory_series)",
            "legendFormat": "Series"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Ingestion Latency",
        "type": "timeseries",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_request_duration_seconds_bucket{route=\"/api/v1/push\"}[5m])) by (le))",
            "legendFormat": "99th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(cortex_request_duration_seconds_bucket{route=\"/api/v1/push\"}[5m])) by (le))",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 5,
        "title": "Query Latency",
        "type": "timeseries",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_request_duration_seconds_bucket{route=~\"/api/v1/query.*\"}[5m])) by (le))",
            "legendFormat": "99th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(cortex_request_duration_seconds_bucket{route=~\"/api/v1/query.*\"}[5m])) by (le))",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}