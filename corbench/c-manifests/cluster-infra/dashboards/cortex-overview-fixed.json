{
  "__requires": [
    {
      "type": "panel",
      "id": "graph",
      "name": "Graph",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "3.1.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "title": "Corbench Metrics",
  "description": "Cortex PR vs Cortex Release Metrics",
  "tags": ["cortex", "overview", "corbench"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "panels": [
      {
        "id": 1,
        "title": "Ingestion Rate",
        "type": "stat",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(rate(cortex_distributor_samples_in_total{namespace=\"corbench-${prNumber}\"}[5m]))",
            "legendFormat": "Samples/sec"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"}
          }
        }
      },
      {
        "id": 2,
        "title": "Active Series",
        "type": "stat",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(cortex_ingester_memory_series{namespace=\"corbench-${prNumber}\"})",
            "legendFormat": "Series"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "PR vs Release - Cortex Latency 99th Percentile",
        "type": "timeseries",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_request_duration_seconds_bucket{namespace=\"corbench-${prNumber}\",cortex=~\"test-pr-.*\"}[5m])) by (le))",
            "legendFormat": "PR Version - 99th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_request_duration_seconds_bucket{namespace=\"corbench-${prNumber}\",cortex=~\"test-.*\",cortex!~\"test-pr-.*\"}[5m])) by (le))",
            "legendFormat": "Release Version - 99th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "PR vs Release - Ingester Appends Rate",
        "type": "timeseries",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "sum(rate(cortex_distributor_ingester_appends_total{namespace=\"corbench-${prNumber}\",cortex=~\"test-pr-.*\"}[5m]))",
            "legendFormat": "PR Version - Appends/sec"
          },
          {
            "expr": "sum(rate(cortex_distributor_ingester_appends_total{namespace=\"corbench-${prNumber}\",cortex=~\"test-.*\",cortex!~\"test-pr-.*\"}[5m]))",
            "legendFormat": "Release Version - Appends/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "PR vs Release - Ingester Client Request Duration 99th Percentile",
        "type": "timeseries",
        "datasource": "prometheus-meta",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_ingester_client_request_duration_seconds_bucket{namespace=\"corbench-${prNumber}\",cortex=~\"test-pr-.*\"}[5m])) by (le))",
            "legendFormat": "PR Version - 99th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(cortex_ingester_client_request_duration_seconds_bucket{namespace=\"corbench-${prNumber}\",cortex=~\"test-.*\",cortex!~\"test-pr-.*\"}[5m])) by (le))",
            "legendFormat": "Release Version - 99th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      }
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "current": {},
        "datasource": "prometheus-meta",
        "definition": "label_values(namespace)",
        "description": "PR number",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "prNumber",
        "options": [],
        "query": {
          "query": "label_values(namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "corbench-(\\d+)",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}